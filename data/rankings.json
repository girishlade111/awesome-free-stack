  "description": "Ranking system for awesome-free-stack resources",
  "logic": {
    "description": "Overall rank score is computed as a weighted composite of four factors.",
    "factors": [
      {
        "id": "community_votes",
        "name": "Community Votes",
        "icon": "👍",
        "description": "Upvotes and positive reactions from the community via GitHub Discussions",
        "weight": 0.25,
        "max_score": 5,
        "source": "GitHub Discussions poll reactions",
        "refresh_period": "monthly"
      },
      {
        "id": "popularity",
        "name": "Popularity",
        "icon": "📈",
        "description": "Relative popularity based on GitHub stars, npm downloads, and web traffic trends",
        "weight": 0.20,
        "max_score": 5,
        "source": "GitHub API, npm registry, SimilarWeb trends",
        "refresh_period": "quarterly"
      },
      {
        "id": "maintainer_score",
        "name": "Maintainer Score",
        "icon": "🔍",
        "description": "Evaluation by project maintainers based on free tier quality, documentation, and reliability",
        "weight": 0.30,
        "max_score": 5,
        "source": "Maintainer review board (weighted average of 3+ reviews)",
        "refresh_period": "quarterly"
      },
      {
        "id": "free_quality",
        "name": "Free Tier Quality",
        "icon": "🎁",
        "description": "Generosity and usability of the free tier — derived from the free_generosity rating metric",
        "weight": 0.25,
        "max_score": 5,
        "source": "Computed from resources.json ratings.free_generosity",
        "refresh_period": "monthly"
      }
    ],
    "formula": {
      "description": "Weighted sum of all factor scores, normalized to a 0-5 scale.",
      "composite_score": "SUM(factor_score * factor_weight) / SUM(factor_weights)",
      "rounding": "1 decimal place",
      "example": {
        "community_votes": 4.5,
        "popularity": 4.0,
        "maintainer_score": 4.8,
        "free_quality": 5.0,
        "calculation": "(4.5*0.25 + 4.0*0.20 + 4.8*0.30 + 5.0*0.25) / (0.25 + 0.20 + 0.30 + 0.25)",
        "result": 4.6
      }
    },
    "tiebreaker": {
      "primary": "free_quality",
      "secondary": "maintainer_score",
      "tertiary": "community_votes"
    },
    "minimum_entries": {
      "description": "Categories must have at least 5 ranked entries to publish a ranking.",
      "value": 5
    }
  },
